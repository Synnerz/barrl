{
	"schemaVersion": 1,
	"id": "barrl",
	"version": "${version}",
	"name": "Barrl",
	"description": "Rendering library",
	"authors": ["DocilElm"],
	"contact": {
		"homepage": "https://github.com/Synnerz/",
		"sources": "https://github.com/Synnerz/Barrl"
	},
	"license": "AGPL-3.0",
	"icon": "assets/barrl/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "com.github.synnerz.barrl.Barrl",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"barrl.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}